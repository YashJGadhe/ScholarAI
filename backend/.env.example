# Copy to backend/.env and fill in. NEVER commit real keys.

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=scholarai

# ---- Auth ----
JWT_SECRET_KEY=replace-with-64-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS (frontend origin) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- External research APIs ----
# ORCID public API works without keys; client credentials enable member features.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Elsevier Scopus (https://dev.elsevier.com)
SCOPUS_API_KEY=

# Clarivate Web of Science Starter API (https://developer.clarivate.com)
WOS_API_KEY=

# SerpApi Google Scholar Author API (authorized provider — never scrape)
SERPAPI_API_KEY=

# ResearchGate compliant modes: OFF | MANUAL_IMPORT | AUTHORIZED_ACCESS | EXTERNAL_AUTHORIZED_PROVIDER
RESEARCHGATE_MODE=OFF

# ---- Registration domain policy ----
# Comma-separated allowed domains for register endpoint (empty = allow all)
ALLOWED_EMAIL_DOMAINS=raisoni.net,ghrce.raisoni.net
# Domains valid for STUDENT self-registration
STUDENT_EMAIL_DOMAINS=ghrce.raisoni.net

# ---- Background polling scheduler (automatic monitoring) ----
POLLING_ENABLED=true
POLLING_INTERVAL_MINUTES=60
